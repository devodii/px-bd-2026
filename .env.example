# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Telegram ---------------------------------------------------------------
# Create at https://my.telegram.org -> "API development tools" (any app name works)
TG_API_ID=
TG_API_HASH=
# Create a bot by messaging @BotFather on Telegram (/newbot); paste the token it gives you
TG_BOT_TOKEN=
# Optional: comma-separated user ids allowed to send files (the bot tells you your id)
TG_ALLOWED_USER_IDS=

# --- Chunking ---------------------------------------------------------------
CHUNK_SECONDS=300

# --- Whisper ----------------------------------------------------------------
# tiny | base | small | medium | large-v3 | large-v3-turbo  (bigger = more accurate, slower)
WHISPER_MODEL=medium
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
# "en" forces English; leave empty to auto-detect per chunk
WHISPER_LANGUAGE=en
# Names and words from the sermons help Whisper spell them right
# Seconds to rest between chunks so a laptop stays cooler (0 = full speed)
WHISPER_PAUSE_SECONDS=5
WHISPER_INITIAL_PROMPT="A sermon preached at The Compass Assembly, Rumuosi, Port Harcourt. Scripture, Jesus Christ, Holy Spirit, Hallelujah, Amen."

# Host ports (change if they clash with something already running)
POSTGRES_PORT=54329
REDIS_PORT=63790
