# Copy to .env. Never commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres with pgvector. Uses its own schema ("search") so it never touches the Python pipeline's tables.
DATABASE_URL=postgresql://px:px@localhost:54330/px_search?schema=search

# Only for `npm run ingest -- --from-pipeline`: the Python pipeline's Postgres (root docker-compose).
PIPELINE_DATABASE_URL=postgresql://px:px@localhost:54329/px

# Protects /api/ingestion/* (send as `x-api-key` header). Generate with: openssl rand -hex 32
INGESTION_API_KEY=
# Comma-separated browser origins allowed by CORS (empty = same-origin only)
CORS_ORIGINS=

# --- Embeddings (PLACEHOLDER: another teammate is implementing the provider) ---------------------
# Until a real provider is wired in, ingestion stores chunks without vectors and search runs keyword-only.
EMBEDDING_PROVIDER=placeholder
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Set once the model is chosen; enables the HNSW index (npm run vector-index). Not hard-coded anywhere.
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=64

# --- JEV (TypeSafe System One, via @typesafe-ai/sdk) --------------------------------------------
JEV_API_KEY=
# Optional: override the API base URL (leave empty for the SDK default)
JEV_BASE_URL=
JEV_MODEL=
JEV_TIMEOUT_MS=8000
JEV_CONCURRENCY=8

# --- LLM answer layer (PLACEHOLDER adapter; search works without it) -----------------------------
LLM_API_KEY=
LLM_MODEL=

# --- Search tuning -------------------------------------------------------------------------------
SEARCH_VECTOR_LIMIT=30
SEARCH_KEYWORD_LIMIT=20
SEARCH_MERGE_LIMIT=50
SEARCH_FINAL_LIMIT=10
# JEV drops candidates whose relevance is below this (0..1)
SEARCH_MIN_RELEVANCE=0.15

# --- Limits --------------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
INGESTION_RATE_LIMIT_PER_MINUTE=20
MAX_QUERY_LENGTH=500
